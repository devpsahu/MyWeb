rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Vlog posts: anyone can read, only the logged-in admin can write.
    match /vlogs/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Site content (profile photo url, resume url): anyone can read, admin-only write.
    match /site/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
